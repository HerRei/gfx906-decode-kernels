+// gfx906 (GCN 5.1: Radeon VII, MI50, MI60) single-column matvec for Q4_0, Q4_1 and IQ4_NL, with or without expert
+// ids. Each lane computes whole 32-value blocks. The 18-byte blocks are only 2-byte aligned, so they are read with
+// 2-byte loads; Q4_1's 20-byte blocks with 4-byte loads. LPR lanes per row, RPB rows per workgroup. Also does the fused
+// gate + GLU epilogue; products with a fused bias or scale take the generic kernel. Q8_0 stays with the generic kernel
+// (not faster). GGML_CUDA_GCN_MMV=0 turns it off.
+template <ggml_type type>
+static __device__ __forceinline__ float gcn_mmv_dot(const uint8_t * p, const block_q8_1 * y) {
+    const uint16_t * p16 = (const uint16_t *) p;
+    const float d = __half2float(*(const half *) p16);
+    const int * yq = (const int *) y->qs;
+    int s = 0;
+    if constexpr (type == GGML_TYPE_IQ4_NL) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) ((uint32_t) p16[1 + 2*l] | ((uint32_t) p16[2 + 2*l] << 16));
+            const int2 v = get_int_from_table_16(q, kvalues_iq4nl);
+            s = ggml_cuda_dp4a(v.x, yq[l], s);
+            s = ggml_cuda_dp4a(v.y, yq[l + 4], s);
+        }
+        return d * __low2float(y->ds) * (float) s;
+    } else if constexpr (type == GGML_TYPE_Q4_1) { // 20-byte blocks are 4-byte aligned: dm (half2), then 16 bytes
+        const uint32_t * p32 = (const uint32_t *) p;
+        const float2 dm = __half22float2(*(const half2 *) p32);
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) p32[1 + l];
+            s = ggml_cuda_dp4a( q       & 0x0F0F0F0F, yq[l],     s);
+            s = ggml_cuda_dp4a((q >> 4) & 0x0F0F0F0F, yq[l + 4], s);
+        }
+        const float2 ds = __half22float2(y->ds);
+        return dm.x * ds.x * (float) s + dm.y * ds.y;
+    } else { // Q4_0: values are nibble - 8; ds.y = d_y * sum(y)
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) ((uint32_t) p16[1 + 2*l] | ((uint32_t) p16[2 + 2*l] << 16));
+            s = ggml_cuda_dp4a( q       & 0x0F0F0F0F, yq[l],     s);
+            s = ggml_cuda_dp4a((q >> 4) & 0x0F0F0F0F, yq[l + 4], s);
+        }
+        const float2 ds = __half22float2(y->ds);
+        return d * (ds.x * (float) s - 8.0f * ds.y);
+    }
+}
+
+template <ggml_type type, int RPB, int LPR, bool YLDS, bool GATE>
+static __global__ void __launch_bounds__(RPB*LPR, 1) gcn_mmv(
+        const void * __restrict__ vx, const void * __restrict__ vgate, const void * __restrict__ vy, const int32_t * __restrict__ ids,
+        float * __restrict__ dst, const int nrows, const int nb, const int stride_row_x, const int stride_channel_x,
+        const int stride_channel_y, const int nchannels_y, const int stride_channel_dst, const ggml_glu_op glu_op, const float glu_limit) {
+    static_assert(type == GGML_TYPE_Q4_0 || type == GGML_TYPE_Q4_1 || type == GGML_TYPE_IQ4_NL, "unsupported type");
+    constexpr int bs = type == GGML_TYPE_Q4_1 ? 20 : 18;
+    extern __shared__ int gcn_mmv_y[];   // the activation column (nb q8_1 blocks), staged once per workgroup
+    const int c  = blockIdx.y;
+    const int cx = ids ? ids[c] : c;
+    const int cy = ids ? c % nchannels_y : c;
+    const block_q8_1 * ycol = (const block_q8_1 *) vy + (size_t) cy*stride_channel_y;
+    if constexpr (YLDS) {
+        const int * ysrc = (const int *) ycol;
+        for (int i = threadIdx.x; i < nb*9; i += RPB*LPR) {
+            gcn_mmv_y[i] = ysrc[i];
+        }
+        __syncthreads();
+    }
+    const block_q8_1 * y = YLDS ? (const block_q8_1 *) gcn_mmv_y : ycol;
+    const int r  = blockIdx.x*RPB + threadIdx.x / LPR;
+    const int l  = threadIdx.x % LPR;
+    float acc  = 0.0f;
+    float accg = 0.0f;
+    if (r < nrows) {
+        const size_t off = ((size_t) cx*stride_channel_x + (size_t) r*stride_row_x)*bs;
+        const uint8_t * row = (const uint8_t *) vx + off;
+        for (int b = l; b < nb; b += LPR) {
+            acc += gcn_mmv_dot<type>(row + (size_t) b*bs, y + b);
+            if constexpr (GATE) {
+                accg += gcn_mmv_dot<type>((const uint8_t *) vgate + off + (size_t) b*bs, y + b);
+            }
+        }
+    }
+#pragma unroll
+    for (int o = LPR/2; o > 0; o >>= 1) {
+        acc += __shfl_xor(acc, o, 64);
+        if constexpr (GATE) {
+            accg += __shfl_xor(accg, o, 64);
+        }
+    }
+    if (l == 0 && r < nrows) {
+        if constexpr (GATE) {
+            acc = ggml_cuda_op_glu_single(glu_op, accg, acc, glu_limit);
+        }
+        dst[(size_t) c*stride_channel_dst + r] = acc;
+    }
+    if constexpr (!GATE) {
+        GGML_UNUSED_VARS(vgate, glu_op, glu_limit);
+    }
+}
+
+template <ggml_type type, int RPB, int LPR, bool YLDS>
+static void gcn_mmv_launch(
+        const void * vx, const ggml_cuda_mm_fusion_args_device & fusion, const void * vy, const int32_t * ids, float * dst,
+        const int nrows_x, const int nb, const int stride_row_x, const int stride_channel_x, const int stride_channel_y,
+        const int nchannels_y, const int nchannels_dst, const int stride_channel_dst, cudaStream_t stream) {
+    const dim3 grid((nrows_x + RPB - 1)/RPB, nchannels_dst);
+    const size_t shmem = YLDS ? (size_t) nb*sizeof(block_q8_1) : 0;
+    if (fusion.gate) {
+        gcn_mmv<type, RPB, LPR, YLDS, true><<<grid, RPB*LPR, shmem, stream>>>(vx, fusion.gate, vy, ids, dst, nrows_x, nb,
+            stride_row_x, stride_channel_x, stride_channel_y, nchannels_y, stride_channel_dst, fusion.glu_op, fusion.glu_limit);
+    } else {
+        gcn_mmv<type, RPB, LPR, YLDS, false><<<grid, RPB*LPR, shmem, stream>>>(vx, nullptr, vy, ids, dst, nrows_x, nb,
+            stride_row_x, stride_channel_x, stride_channel_y, nchannels_y, stride_channel_dst, fusion.glu_op, fusion.glu_limit);
+    }
+}
+
+template <ggml_type type>
+static bool gcn_mmv_try(
+        const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int ncols_dst, const int stride_row_x, const int nchannels_x,
+        const int nchannels_y, const int nchannels_dst, const int stride_channel_x, const int stride_channel_y,
+        const int stride_channel_dst, const int nsamples_x, const int nsamples_dst, const int cc, cudaStream_t stream) {
+    if constexpr (type != GGML_TYPE_Q4_0 && type != GGML_TYPE_Q4_1 && type != GGML_TYPE_IQ4_NL) {
+        return false;
+    } else {
+        static const bool on = [] { const char * e = getenv("GGML_CUDA_GCN_MMV"); return !(e && e[0] == '0'); }();
+        if (!on || cc != GGML_CUDA_CC_VEGA20 || ncols_dst != 1 || nsamples_x != 1 || nsamples_dst != 1) {
+            return false;
+        }
+        // the fused gate + GLU epilogue is handled here; fused biases and scales take the generic kernel
+        if (fusion.x_bias || fusion.gate_bias || fusion.x_scale || fusion.gate_scale || fusion.shared_up) {
+            return false;
+        }
+        if (!ids && nchannels_x != nchannels_dst) {
+            return false; // broadcast over channels: leave to the generic kernel
+        }
+        const int nb = ncols_x / 32;
+        if (nb > 1024) {
+            return false; // keeps the staged activation under 36 KB of LDS
+        }
+        // 128-thread workgroups; with 64 threads the Radeon VII hits a ~57 us floor at about 2048 workgroups.
+        // Experts (8 of 128): 16 rows x 8 lanes with the activation in LDS. Dense: 4 rows x 32 lanes, 2 x 64 below
+        // 2048 rows, 8 x 16 for K < 2048; below 512 rows the generic kernel is as fast.
+        if (ids) {
+            gcn_mmv_launch<type, 16, 8, true>(vx, fusion, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x,
+                stride_channel_y, nchannels_y, nchannels_dst, stride_channel_dst, stream);
+        } else if (nrows_x < 512) {
+            return false;
+        } else if (nb < 64) {
+            gcn_mmv_launch<type, 8, 16, false>(vx, fusion, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x,
+                stride_channel_y, nchannels_y, nchannels_dst, stride_channel_dst, stream);
+        } else if (nrows_x < 2048) {
+            gcn_mmv_launch<type, 2, 64, false>(vx, fusion, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x,
+                stride_channel_y, nchannels_y, nchannels_dst, stride_channel_dst, stream);
+        } else {
+            gcn_mmv_launch<type, 4, 32, false>(vx, fusion, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x,
+                stride_channel_y, nchannels_y, nchannels_dst, stride_channel_dst, stream);
+        }
+        return true;
+    }
+}
