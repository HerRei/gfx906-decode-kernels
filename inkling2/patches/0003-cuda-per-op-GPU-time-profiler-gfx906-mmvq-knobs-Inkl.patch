From 1569361a12fb1f30dd4c80d55a4467f4a1beef09 Mon Sep 17 00:00:00 2001
From: Hermes Reisner <hermes.reisner@stud.unibas.ch>
Date: Sun, 22 Nov 2026 17:10:18 +0100
Subject: [PATCH 3/6] cuda : per-op GPU time profiler, gfx906 mmvq knobs,
 Inkling 2 perf cases

GGML_CUDA_OPPROF=1 (with GGML_CUDA_DISABLE_GRAPHS=1) times every op or fused group with events and
prints a table per device. It overstates small ops (one sync per op); use test-backend-ops perf for
in-graph numbers. GCN_MMV_NW / GCN_MMV_RPB make the gfx906 single-column mmvq shape a build-time
setting (defaults unchanged). test-backend-ops perf gets the Inkling 2 Mini decode shapes.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 62 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/mmvq.cu      | 19 +++++++++-
 tests/test-backend-ops.cpp      | 12 +++++++
 3 files changed, 92 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 35e01e231..76de7414c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5846,6 +5846,65 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
     return 0;
 }
 
+// GGML_CUDA_OPPROF=1 (use with GGML_CUDA_DISABLE_GRAPHS=1) times every op (or fused group) with events and prints a
+// per-device table of GPU time by op kind every GGML_CUDA_OPPROF_EVERY nodes (default 200000). Measurement only.
+#include <map>
+#include <string>
+#include <vector>
+#include <algorithm>
+#if defined(GGML_USE_HIP)
+#define OPPROF_EV_DEFAULT hipEventDefault
+#define OPPROF_EV_ELAPSED hipEventElapsedTime
+#else
+#define OPPROF_EV_DEFAULT cudaEventDefault
+#define OPPROF_EV_ELAPSED cudaEventElapsedTime
+#endif
+struct opprof_stat { double ms = 0; long n = 0; };
+static bool opprof_on() { static const bool on = getenv("GGML_CUDA_OPPROF") != nullptr; return on; }
+static std::map<std::string, opprof_stat> & opprof_map() { static std::map<std::string, opprof_stat> m; return m; }
+static cudaEvent_t opprof_ev[GGML_CUDA_MAX_DEVICES][2];
+static bool opprof_ev_init[GGML_CUDA_MAX_DEVICES] = {};
+static long opprof_nodes = 0;
+static std::string opprof_key(const ggml_tensor * t) {
+    std::string k = ggml_op_name(t->op);
+    if (t->op == GGML_OP_UNARY) { k += std::string(".") + ggml_unary_op_name(ggml_get_unary_op(t)); }
+    if (t->op == GGML_OP_GLU) { k += std::string(".") + ggml_glu_op_name(ggml_get_glu_op(t)); }
+    if ((t->op == GGML_OP_MUL_MAT || t->op == GGML_OP_MUL_MAT_ID) && t->src[0]) {
+        k += std::string(" ") + ggml_type_name(t->src[0]->type) + " " + std::to_string(t->src[0]->ne[0]) + "x" + std::to_string(t->src[0]->ne[1]) +
+             " n" + std::to_string(t->src[1] ? t->src[1]->ne[1] : 0);
+    }
+    return k;
+}
+static void opprof_begin(ggml_backend_cuda_context * ctx) {
+    if (!opprof_on()) return;
+    const int d = ctx->device;
+    if (!opprof_ev_init[d]) { CUDA_CHECK(cudaEventCreateWithFlags(&opprof_ev[d][0], OPPROF_EV_DEFAULT)); CUDA_CHECK(cudaEventCreateWithFlags(&opprof_ev[d][1], OPPROF_EV_DEFAULT)); opprof_ev_init[d] = true; }
+    CUDA_CHECK(cudaEventRecord(opprof_ev[d][0], ctx->stream()));
+}
+static void opprof_end(ggml_backend_cuda_context * ctx, const ggml_cgraph * g, int first, int skip) {
+    if (!opprof_on()) return;
+    const int d = ctx->device;
+    CUDA_CHECK(cudaEventRecord(opprof_ev[d][1], ctx->stream()));
+    CUDA_CHECK(cudaEventSynchronize(opprof_ev[d][1]));
+    float ms = 0; CUDA_CHECK(OPPROF_EV_ELAPSED(&ms, opprof_ev[d][0], opprof_ev[d][1]));
+    std::string k = "dev" + std::to_string(d) + " ";
+    if (skip > 0) { k += "FUSED" + std::to_string(skip + 1) + " " + opprof_key(g->nodes[first]) + " > " + ggml_op_name(g->nodes[first + skip]->op); }
+    else { k += opprof_key(g->nodes[first]); }
+    auto & st = opprof_map()[k]; st.ms += ms; st.n++;
+    static const long every = getenv("GGML_CUDA_OPPROF_EVERY") ? atol(getenv("GGML_CUDA_OPPROF_EVERY")) : 200000;
+    if (++opprof_nodes % every == 0) {
+        std::vector<std::pair<std::string, opprof_stat>> v(opprof_map().begin(), opprof_map().end());
+        std::sort(v.begin(), v.end(), [](auto & a, auto & b) { return a.second.ms > b.second.ms; });
+        double tot = 0; long ntot = 0; for (auto & e : v) { tot += e.second.ms; ntot += e.second.n; }
+        fprintf(stderr, "OPPROF after %ld nodes: total %.1f ms over %ld launches\n", opprof_nodes, tot, ntot);
+        for (size_t i = 0; i < std::min<size_t>(v.size(), 45); ++i) {
+            fprintf(stderr, "OPPROF %6.2f%% %9.1f ms %8ld x %7.2f us  %s\n", 100 * v[i].second.ms / tot, v[i].second.ms, v[i].second.n,
+                          1000 * v[i].second.ms / v[i].second.n, v[i].first.c_str());
+        }
+        opprof_map().clear();
+    }
+}
+
 static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, const bool use_cuda_graph, const bool cuda_graph_update_required, const void * graph_key) {
     bool graph_evaluated_or_captured = false;
 
@@ -6003,6 +6062,7 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                opprof_begin(cuda_ctx);
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 // drop cached q8_1 inputs whose memory this node (or fused group) writes
@@ -6019,6 +6079,7 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                             nodes_to_skip + 1, ggml_op_name(node->op), node->name,
                             ggml_op_name(cgraph->nodes[last_fused]->op), cgraph->nodes[last_fused]->name);
 #endif
+                    opprof_end(cuda_ctx, cgraph, i, nodes_to_skip);
                     i += nodes_to_skip;
                     continue;
                 }
@@ -6044,6 +6105,7 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     GGML_LOG_ERROR("%s: op not supported %s (%s)\n", __func__, node->name, ggml_op_name(node->op));
                 }
                 GGML_ASSERT(ok);
+                opprof_end(cuda_ctx, cgraph, i, 0);
 
                 if (!is_concurrent_event_active) {
                     try_launch_concurrent_event(node);
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index bcd16c966..b4d1bcb01 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1,4 +1,14 @@
 #include "mmvq.cuh"
+
+// gfx906 (Radeon VII) single-column tuning for Q8_0 / IQ4_NL (Inkling 2 Mini decode).
+// GCN_MMV_NW = warps per block, GCN_MMV_RPB = rows per block (row tails fall back to the small_k variant).
+#ifndef GCN_MMV_NW
+#define GCN_MMV_NW 2
+#endif
+#ifndef GCN_MMV_RPB
+#define GCN_MMV_RPB 1
+#endif
+#define GCN_MMV_TUNED(type) ((type) == GGML_TYPE_Q8_0 || (type) == GGML_TYPE_IQ4_NL)
 #include "quantize.cuh"
 #include "unary.cuh"
 #include "vecdotq.cuh"
@@ -485,7 +495,7 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
     } else if (table_id == MMVQ_PARAMETERS_GCN) {
         switch (ncols_dst) {
             case 1:
-                return 2;
+                return GCN_MMV_TUNED(type) && !small_k ? GCN_MMV_NW : 2;
             case 2:
             case 3:
                 return type == GGML_TYPE_Q3_K ? 1 : 2;
@@ -640,6 +650,9 @@ static constexpr __host__ __device__ int calc_rows_per_block(ggml_type type, int
                 if (table_id == MMVQ_PARAMETERS_GB10) {
                     return type == GGML_TYPE_IQ2_S || type == GGML_TYPE_IQ3_S ? 2 : 1;
                 }
+                if (table_id == MMVQ_PARAMETERS_GCN && GCN_MMV_TUNED(type)) {
+                    return GCN_MMV_RPB;
+                }
                 return (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_RDNA1) && mmvq_two_rows_ncols1(type) ? 2 : 1;
             case 2:
             case 3:
@@ -1252,6 +1265,10 @@ static void mul_mat_vec_q_switch_ncols_dst(
             use = false;
         }
 
+        // gfx906 with several rows per block: a row tail takes the small_k variant
+        if (table_id == MMVQ_PARAMETERS_GCN && c_ncols_dst == 1 && GCN_MMV_TUNED(type) && GCN_MMV_RPB > 1 && nrows_x % GCN_MMV_RPB != 0) {
+            use = true;
+        }
         // RDNA3 Q8_0/IQ4_NL single columns run 4 rows per block; small_k selects the 1-row variant for a row tail
         if (table_id == MMVQ_PARAMETERS_RDNA3_0 && c_ncols_dst == 1 && (type == GGML_TYPE_Q8_0 || type == GGML_TYPE_IQ4_NL)) {
             use = nrows_x % 4 != 0;
