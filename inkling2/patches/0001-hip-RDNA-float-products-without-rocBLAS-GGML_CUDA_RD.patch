From 79d86bcf9178ada2edfbd7c1d380444d65e3c64b Mon Sep 17 00:00:00 2001
From: Hermes Reisner <hermes.reisner@stud.unibas.ch>
Date: Sun, 22 Nov 2026 14:24:16 +0100
Subject: [PATCH 1/6] hip : RDNA float products without rocBLAS
 (GGML_CUDA_RDNA_NO_BLAS=1)

Fedora's rocBLAS 7.1 loads the kernel library of only one GPU per process, so with a gfx1200 and a gfx906
card in one process the second card fails with "no kernel image is available". With the variable set,
RDNA cards compute F32/F16/BF16 products with the vector kernel in column chunks, and odd shapes (the
K=3 depth mix of Inkling 2) with a plain kernel. Every other case still uses rocBLAS.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 104 ++++++++++++++++++++++++++++++++
 1 file changed, 104 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index fc3a3ecb9..35e01e231 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2543,6 +2543,102 @@ static bool ggml_cuda_should_fuse_mul_mat_q(const ggml_tensor * up, const ggml_t
     return ggml_cuda_mmq_fusion_is_efficient(x_up->type, ggml_prec_get_src(up, 1), x_up->ne[1], ncols, nchannels, device);
 }
 
+// RDNA without rocBLAS, part 2: plain fallback for float products that the vector kernel refuses (odd K, e.g. the K=3 block mix of
+// inkling2_loop, or batched/broadcast shapes). One thread per output element; meant for small products only.
+template <typename src0_t>
+static __global__ void rdna_naive_mul_mat_f(const char * __restrict__ x, const char * __restrict__ y, char * __restrict__ d,
+        const int64_t ne00, const int64_t ne01, const int64_t ne02, const int64_t ne03,
+        const int64_t ne11, const int64_t ne12, const int64_t ne13,
+        const size_t nb00, const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t nb10, const size_t nb11, const size_t nb12, const size_t nb13,
+        const size_t nb0, const size_t nb1, const size_t nb2, const size_t nb3) {
+    const int64_t n = ne01*ne11*ne12*ne13;
+    for (int64_t idx = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; idx < n; idx += (int64_t) gridDim.x*blockDim.x) {
+        const int64_t i0 = idx % ne01;
+        const int64_t i1 = (idx / ne01) % ne11;
+        const int64_t i2 = (idx / (ne01*ne11)) % ne12;
+        const int64_t i3 = idx / (ne01*ne11*ne12);
+        const int64_t i02 = i2 / (ne12/ne02);
+        const int64_t i03 = i3 / (ne13/ne03);
+        const char * xr = x + i0*nb01 + i02*nb02 + i03*nb03;
+        const char * yr = y + i1*nb11 + i2*nb12 + i3*nb13;
+        float sum = 0.0f;
+        for (int64_t k = 0; k < ne00; ++k) {
+            sum += ggml_cuda_cast<float>(*(const src0_t *) (xr + k*nb00)) * *(const float *) (yr + k*nb10);
+        }
+        *(float *) (d + i0*nb0 + i1*nb1 + i2*nb2 + i3*nb3) = sum;
+    }
+}
+
+static bool rdna_naive_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src1->ne[2] % src0->ne[2] != 0 || src1->ne[3] % src0->ne[3] != 0) {
+        return false;
+    }
+    const int64_t n = src0->ne[1]*src1->ne[1]*src1->ne[2]*src1->ne[3];
+    const int threads = 256;
+    const int blocks = (int) std::min<int64_t>((n + threads - 1)/threads, 65535);
+    cudaStream_t stream = ctx.stream();
+#define RDNA_NAIVE(T) rdna_naive_mul_mat_f<T><<<blocks, threads, 0, stream>>>((const char *) src0->data, (const char *) src1->data, (char *) dst->data, \
+        src0->ne[0], src0->ne[1], src0->ne[2], src0->ne[3], src1->ne[1], src1->ne[2], src1->ne[3], \
+        src0->nb[0], src0->nb[1], src0->nb[2], src0->nb[3], src1->nb[0], src1->nb[1], src1->nb[2], src1->nb[3], \
+        dst->nb[0], dst->nb[1], dst->nb[2], dst->nb[3])
+    switch (src0->type) {
+        case GGML_TYPE_F32:  RDNA_NAIVE(float);         break;
+        case GGML_TYPE_F16:  RDNA_NAIVE(half);          break;
+        case GGML_TYPE_BF16: RDNA_NAIVE(nv_bfloat16);   break;
+        default: return false;
+    }
+#undef RDNA_NAIVE
+    return true;
+}
+
+// RDNA without rocBLAS: Fedora ROCm 7.1 rocBLAS loads the kernel library of
+// only ONE GPU per process, so on a gfx1200 + gfx906 pair the second card dies with "no kernel image". With
+// GGML_CUDA_RDNA_NO_BLAS=1 RDNA cards compute float (F32/F16/BF16) products with llama.cpp's own vector kernel in column
+// chunks instead of calling rocBLAS. Only for plain 2D products; anything else still goes to rocBLAS.
+static bool rdna_no_blas_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        ggml_tensor * dst, int cc, int warp_size) {
+    static const bool on = getenv("GGML_CUDA_RDNA_NO_BLAS") != nullptr;
+    if (!on || !GGML_CUDA_CC_IS_RDNA(cc)) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16 && src0->type != GGML_TYPE_BF16) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || dst->ne[2] != 1 || dst->ne[3] != 1) {
+        return rdna_naive_mul_mat(ctx, src0, src1, dst);
+    }
+    if (!ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
+        return rdna_naive_mul_mat(ctx, src0, src1, dst);
+    }
+    int64_t chunk = MMVF_MAX_BATCH_SIZE;
+    while (chunk > 1 && !ggml_cuda_should_use_mmvf(src0, cc, warp_size, chunk)) {
+        chunk--;
+    }
+    if (!ggml_cuda_should_use_mmvf(src0, cc, warp_size, chunk)) {
+        return rdna_naive_mul_mat(ctx, src0, src1, dst);
+    }
+    const int64_t ne11 = src1->ne[1];
+    for (int64_t i0 = 0; i0 < ne11; i0 += chunk) {
+        const int64_t n = std::min(chunk, ne11 - i0);
+        ggml_tensor s1 = *src1;
+        s1.ne[1] = n;
+        s1.data  = (char *) src1->data + i0*src1->nb[1];
+        s1.nb[2] = s1.nb[1]*n;
+        s1.nb[3] = s1.nb[2];
+        ggml_tensor d = *dst;
+        d.ne[1] = n;
+        d.data  = (char *) dst->data + i0*dst->nb[1];
+        d.nb[2] = d.nb[1]*n;
+        d.nb[3] = d.nb[2];
+        ggml_cuda_mul_mat_vec_f(ctx, src0, &s1, nullptr, &d);
+    }
+    return true;
+}
+
 static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
     GGML_TENSOR_BINARY_OP_LOCALS
 
@@ -2556,6 +2652,11 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
     const bool bad_padding_clear = ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE
         && ggml_nbytes(src0) != ggml_backend_buffer_get_alloc_size(src0->buffer, src0) && src0->view_src;
     if (bad_padding_clear || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        if (getenv("GGML_CUDA_RDNA_NO_BLAS") && GGML_CUDA_CC_IS_RDNA(ggml_cuda_info().devices[ctx.device].cc)
+                && (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16)
+                && rdna_naive_mul_mat(ctx, src0, src1, dst)) {
+            return;
+        }
         ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
         return;
     }
@@ -2604,6 +2705,9 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
     if (src0->type == GGML_TYPE_F8_E4M3 && ggml_cuda_mul_mat_fp8(ctx, src0, src1, dst)) {
         return;
     }
+    if (rdna_no_blas_mul_mat(ctx, src0, src1, dst, cc, warp_size)) {
+        return;
+    }
     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
 }
 
