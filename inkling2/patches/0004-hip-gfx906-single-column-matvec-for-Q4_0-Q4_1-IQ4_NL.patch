From 18dbd29f89b15bb23930b5e32fdf21292be134ff Mon Sep 17 00:00:00 2001
From: Hermes Reisner <hermes.reisner@stud.unibas.ch>
Date: Sun, 22 Nov 2026 18:33:10 +0100
Subject: [PATCH 4/6] hip : gfx906 single-column matvec for Q4_0, Q4_1, IQ4_NL
 and Q8_0

On the Radeon VII the generic mmvq kernel reached ~300 GB/s for the MoE expert products of Inkling 2
Mini. Here each lane computes whole 32-value blocks from 2-byte loads (the blocks are only 2-byte
aligned); expert products use 16 rows x 8 lanes with the activation in LDS, dense ones 2x32 or 8x8.
Only for one column without fused epilogues; GGML_CUDA_GCN_MMV=0 turns it off.

8 of 128 experts, one token, test-backend-ops perf on the VII:
  IQ4_NL 2304x2304  80.4 -> 64.2 us     Q4_1 2304x2304  43.5 us
  IQ4_NL 1152->2304 46.9 -> 36.3 us     Q4_1 1152->2304 25.2 us
IQ4_NL's table lookup is what limits it on this card; Q4_1 needs none.
---
 ggml/src/ggml-cuda/mmvq.cu | 138 +++++++++++++++++++++++++++++++++++++
 tests/test-backend-ops.cpp |   3 +-
 2 files changed, 140 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index b4d1bcb01..de92bb2ea 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1200,6 +1200,139 @@ static void mul_mat_vec_q_moe_launch(
     }
 }
 
+
+// ---------------------------------------------------------------------------------------------------------------------
+// gfx906 (GCN 5.1: Radeon VII, MI50, MI60) single-column matvec for Q4_0, Q4_1, IQ4_NL and Q8_0, with or without
+// expert ids. Each lane computes whole 32-value blocks. The 18- and 34-byte blocks are only 2-byte aligned, so they
+// are read with 2-byte loads; Q4_1's 20-byte blocks with 4-byte loads. LPR lanes per row, RPB rows per workgroup.
+// Not used with fused epilogues. GGML_CUDA_GCN_MMV=0 turns it off.
+template <ggml_type type>
+static __device__ __forceinline__ float gcn_mmv_dot(const uint8_t * p, const block_q8_1 * y) {
+    const uint16_t * p16 = (const uint16_t *) p;
+    const float d = __half2float(*(const half *) p16);
+    const int * yq = (const int *) y->qs;
+    int s = 0;
+    if constexpr (type == GGML_TYPE_Q8_0) {
+#pragma unroll
+        for (int l = 0; l < 8; ++l) {
+            const int q = (int) ((uint32_t) p16[1 + 2*l] | ((uint32_t) p16[2 + 2*l] << 16));
+            s = ggml_cuda_dp4a(q, yq[l], s);
+        }
+        return d * __low2float(y->ds) * (float) s;
+    } else if constexpr (type == GGML_TYPE_IQ4_NL) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) ((uint32_t) p16[1 + 2*l] | ((uint32_t) p16[2 + 2*l] << 16));
+            const int2 v = get_int_from_table_16(q, kvalues_iq4nl);
+            s = ggml_cuda_dp4a(v.x, yq[l], s);
+            s = ggml_cuda_dp4a(v.y, yq[l + 4], s);
+        }
+        return d * __low2float(y->ds) * (float) s;
+    } else if constexpr (type == GGML_TYPE_Q4_1) { // 20-byte blocks are 4-byte aligned: dm (half2), then 16 bytes
+        const uint32_t * p32 = (const uint32_t *) p;
+        const float2 dm = __half22float2(*(const half2 *) p32);
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) p32[1 + l];
+            s = ggml_cuda_dp4a( q       & 0x0F0F0F0F, yq[l],     s);
+            s = ggml_cuda_dp4a((q >> 4) & 0x0F0F0F0F, yq[l + 4], s);
+        }
+        const float2 ds = __half22float2(y->ds);
+        return dm.x * ds.x * (float) s + dm.y * ds.y;
+    } else { // Q4_0: values are nibble - 8; ds.y = d_y * sum(y)
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int q = (int) ((uint32_t) p16[1 + 2*l] | ((uint32_t) p16[2 + 2*l] << 16));
+            s = ggml_cuda_dp4a( q       & 0x0F0F0F0F, yq[l],     s);
+            s = ggml_cuda_dp4a((q >> 4) & 0x0F0F0F0F, yq[l + 4], s);
+        }
+        const float2 ds = __half22float2(y->ds);
+        return d * (ds.x * (float) s - 8.0f * ds.y);
+    }
+}
+
+template <ggml_type type, int RPB, int LPR, bool YLDS>
+static __global__ void __launch_bounds__(RPB*LPR, 1) gcn_mmv(
+        const void * __restrict__ vx, const void * __restrict__ vy, const int32_t * __restrict__ ids, float * __restrict__ dst,
+        const int nrows, const int nb, const int stride_row_x, const int stride_channel_x,
+        const int stride_channel_y, const int nchannels_y, const int stride_channel_dst) {
+    constexpr int bs = ggml_cuda_type_traits<type>::qk == 32 ? (type == GGML_TYPE_Q8_0 ? 34 : type == GGML_TYPE_Q4_1 ? 20 : 18) : 0;
+    static_assert(bs != 0, "unsupported type");
+    extern __shared__ int gcn_mmv_y[];   // the activation column (nb q8_1 blocks), staged once per workgroup
+    const int c  = blockIdx.y;
+    const int cx = ids ? ids[c] : c;
+    const int cy = ids ? c % nchannels_y : c;
+    const block_q8_1 * ycol = (const block_q8_1 *) vy + (size_t) cy*stride_channel_y;
+    if constexpr (YLDS) {
+        const int * ysrc = (const int *) ycol;
+        for (int i = threadIdx.x; i < nb*9; i += RPB*LPR) {
+            gcn_mmv_y[i] = ysrc[i];
+        }
+        __syncthreads();
+    }
+    const block_q8_1 * y = YLDS ? (const block_q8_1 *) gcn_mmv_y : ycol;
+    const int r  = blockIdx.x*RPB + threadIdx.x / LPR;
+    const int l  = threadIdx.x % LPR;
+    float acc = 0.0f;
+    if (r < nrows) {
+        const uint8_t * row = (const uint8_t *) vx + ((size_t) cx*stride_channel_x + (size_t) r*stride_row_x)*bs;
+        for (int b = l; b < nb; b += LPR) {
+            acc += gcn_mmv_dot<type>(row + (size_t) b*bs, y + b);
+        }
+    }
+#pragma unroll
+    for (int o = LPR/2; o > 0; o >>= 1) {
+        acc += __shfl_xor(acc, o, 64);
+    }
+    if (l == 0 && r < nrows) {
+        dst[(size_t) c*stride_channel_dst + r] = acc;
+    }
+}
+
+template <ggml_type type>
+static bool gcn_mmv_try(
+        const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int ncols_dst, const int stride_row_x, const int nchannels_x,
+        const int nchannels_y, const int nchannels_dst, const int stride_channel_x, const int stride_channel_y,
+        const int stride_channel_dst, const int nsamples_x, const int nsamples_dst, const int cc, cudaStream_t stream) {
+    if constexpr (type != GGML_TYPE_Q4_0 && type != GGML_TYPE_Q4_1 && type != GGML_TYPE_IQ4_NL && type != GGML_TYPE_Q8_0) {
+        return false;
+    } else {
+        static const bool on = [] { const char * e = getenv("GGML_CUDA_GCN_MMV"); return !(e && e[0] == '0'); }();
+        if (!on || !GGML_CUDA_CC_IS_GCN(cc) || ncols_dst != 1 || nsamples_x != 1 || nsamples_dst != 1) {
+            return false;
+        }
+        if (fusion.x_bias || fusion.gate || fusion.gate_bias || fusion.x_scale || fusion.gate_scale || fusion.shared_up) {
+            return false;
+        }
+        if (ids && type == GGML_TYPE_Q8_0) {
+            return false; // Q8_0 experts: slower than the generic kernel here (121 vs 103 us)
+        }
+        if (!ids && nchannels_x != nchannels_dst) {
+            return false; // broadcast over channels: leave to the generic kernel
+        }
+        const int nb = ncols_x / 32;
+        if (nb > 1024) {
+            return false; // keeps the staged activation under 36 KB of LDS
+        }
+        // measured on a Radeon VII (n = 1): experts (8 of 128): 16 rows x 8 lanes with the activation in LDS;
+        // dense: no LDS, 2 rows x 32 lanes (K >= 2048) or 8 x 8, so that small matrices still fill the 60 CUs
+        const size_t shmem = (size_t) nb*sizeof(block_q8_1);
+        if (ids) {
+            gcn_mmv<type, 16, 8, true><<<dim3((nrows_x + 15)/16, nchannels_dst), 128, shmem, stream>>>(
+                vx, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x, stride_channel_y, nchannels_y, stride_channel_dst);
+        } else if (nb >= 64) {
+            gcn_mmv<type, 2, 32, false><<<dim3((nrows_x + 1)/2, nchannels_dst), 64, 0, stream>>>(
+                vx, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x, stride_channel_y, nchannels_y, stride_channel_dst);
+        } else {
+            gcn_mmv<type, 8, 8, false><<<dim3((nrows_x + 7)/8, nchannels_dst), 64, 0, stream>>>(
+                vx, vy, ids, dst, nrows_x, nb, stride_row_x, stride_channel_x, stride_channel_y, nchannels_y, stride_channel_dst);
+        }
+        return true;
+    }
+}
+// ---------------------------------------------------------------------------------------------------------------------
+
 template <ggml_type type>
 static void mul_mat_vec_q_switch_ncols_dst(
         const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
@@ -1224,6 +1357,11 @@ static void mul_mat_vec_q_switch_ncols_dst(
 
     const bool has_ids = ids != nullptr;
 
+    if (gcn_mmv_try<type>(vx, vy, ids, fusion, dst, ncols_x, nrows_x, ncols_dst, stride_row_x, nchannels_x, nchannels_y,
+            nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst, nsamples_x, nsamples_dst, cc, stream)) {
+        return;
+    }
+
     // How the K loop divides up at the baseline block width, both decisions below use these.
     constexpr int qk                    = ggml_cuda_type_traits<type>::qk;
     constexpr int qi                    = ggml_cuda_type_traits<type>::qi;
