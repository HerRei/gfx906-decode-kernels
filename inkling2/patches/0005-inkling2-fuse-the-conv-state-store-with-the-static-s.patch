+// cat_store + conv_res in one kernel
+// x = concat(past [P, C], xt [T, C], 0); state[P*c + j] = x[T + j, c]; dst[t*C + c] = scale*(cur[t, c] + sum_k w[k, c]*x[t + k, c])
+// (one sequence). Replaces CONCAT VIEW VIEW CPY SSM_CONV RESHAPE ADD SCALE; the concat itself is never written.
+static __global__ void k_ink_cat_conv_res(const char * __restrict__ past, const char * __restrict__ xt, const float * __restrict__ w,
+        const float * __restrict__ cur, float * __restrict__ dst, float * __restrict__ state, const int P, const int T, const int C,
+        const size_t p_nb0, const size_t p_nb1, const size_t x_nb0, const size_t x_nb1, const int64_t cur_nb1, const float scale) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= (int64_t) C*T) {
+        return;
+    }
+    const int c = i % C;
+    const int t = i / C;
+    auto xv = [&](int j) -> float {
+        return j < P ? *(const float *) (past + j*p_nb0 + c*p_nb1) : *(const float *) (xt + (j - P)*x_nb0 + c*x_nb1);
+    };
+    const float * wc = w + (size_t) c*(P + 1);
+    float acc = 0.0f;
+    for (int k = 0; k <= P; ++k) {
+        acc += xv(t + k)*wc[k];
+    }
+    dst[(size_t) t*C + c] = scale*(cur[(size_t) t*cur_nb1 + c] + acc);
+    if (t == 0) {
+        for (int j = 0; j < P; ++j) {
+            state[(size_t) P*c + j] = xv(T + j);
+        }
+    }
+}
+
+void ggml_cuda_ink_cat_conv_res(ggml_backend_cuda_context & ctx, const ggml_tensor * past, const ggml_tensor * xt, const ggml_tensor * w,
+        const ggml_tensor * cur, float scale, ggml_tensor * dst, ggml_tensor * state) {
+    GGML_ASSERT(past->type == GGML_TYPE_F32 && xt->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && state->type == GGML_TYPE_F32 && ggml_is_contiguous(dst) && ggml_is_contiguous(state));
+    GGML_ASSERT(ggml_is_contiguous(w) && cur->nb[0] == sizeof(float));
+    const int P = past->ne[0], T = xt->ne[0], C = past->ne[1];
+    GGML_ASSERT(w->ne[0] == P + 1 && w->ne[1] == C && xt->ne[1] == C && cur->ne[0] == C && ggml_nelements(dst) == (int64_t) C*T);
+    GGML_ASSERT(ggml_nelements(state) == (int64_t) P*C);
+    const int64_t n = (int64_t) C*T;
+    const int bs = 256;
+    k_ink_cat_conv_res<<<(n + bs - 1)/bs, bs, 0, ctx.stream()>>>((const char *) past->data, (const char *) xt->data, (const float *) w->data,
+            (const float *) cur->data, (float *) dst->data, (float *) state->data, P, T, C, past->nb[0], past->nb[1], xt->nb[0], xt->nb[1],
+            cur->nb[1]/sizeof(float), scale);
+}
